# Auto-Connection API Tests
# Story 6.2: Auto-Connection Engine
# Base URL: http://localhost:3000

###
# Test 1: Get connection suggestions for a board
# Finds potential connections between cards based on keyword similarity

GET http://localhost:3000/api/boards/f9ded4ca-834f-4254-984c-8eab64ad27ae/connections/suggest?minConfidence=0.1
Content-Type: application/json

###
# Test 2: Get connection suggestions for a specific card
# Finds cards similar to a specific card

GET http://localhost:3000/api/cards/86f39832-e8b6-41e5-8b1d-195048294a8c/connections/suggest?minConfidence=0.1
Content-Type: application/json

###
# Test 3: Create a manual connection (no auto-fields)

POST http://localhost:3000/api/boards/f9ded4ca-834f-4254-984c-8eab64ad27ae/connections
Content-Type: application/json

{
  "sourceCardId": "86f39832-e8b6-41e5-8b1d-195048294a8c",
  "targetCardId": "62187e1a-3ad3-4c0f-864b-9b1cf3a0bec1",
  "label": "related to"
}

###
# Test 4: Create an auto-generated connection (with confidence & reason)

POST http://localhost:3000/api/boards/f9ded4ca-834f-4254-984c-8eab64ad27ae/connections
Content-Type: application/json

{
  "sourceCardId": "86f39832-e8b6-41e5-8b1d-195048294a8c",
  "targetCardId": "71fcc86a-8514-46eb-b3fa-a3cc306bc6d1",
  "confidence": 0.85,
  "reason": "Both discuss mobile app development",
  "isAutoGenerated": true
}

###
# Test 5: Get all connections for a board

GET http://localhost:3000/api/boards/f9ded4ca-834f-4254-984c-8eab64ad27ae/connections
Content-Type: application/json

###
# Test 6: Get all connections for a specific card

GET http://localhost:3000/api/cards/86f39832-e8b6-41e5-8b1d-195048294a8c/connections
Content-Type: application/json

###
# Test 7: Delete a connection

DELETE http://localhost:3000/api/connections/YOUR_CONNECTION_ID_HERE
Content-Type: application/json

###
# Test 8: Try different confidence thresholds
# Low threshold (0.1) = more suggestions
# High threshold (0.5) = only very similar cards

GET http://localhost:3000/api/boards/f9ded4ca-834f-4254-984c-8eab64ad27ae/connections/suggest?minConfidence=0.5
Content-Type: application/json

###
# Test 9: Error case - Self-connection (should fail)

POST http://localhost:3000/api/boards/f9ded4ca-834f-4254-984c-8eab64ad27ae/connections
Content-Type: application/json

{
  "sourceCardId": "86f39832-e8b6-41e5-8b1d-195048294a8c",
  "targetCardId": "86f39832-e8b6-41e5-8b1d-195048294a8c"
}

###
# Test 10: Error case - Duplicate connection (should fail)
# Try creating the same connection twice

POST http://localhost:3000/api/boards/f9ded4ca-834f-4254-984c-8eab64ad27ae/connections
Content-Type: application/json

{
  "sourceCardId": "86f39832-e8b6-41e5-8b1d-195048294a8c",
  "targetCardId": "62187e1a-3ad3-4c0f-864b-9b1cf3a0bec1"
}
